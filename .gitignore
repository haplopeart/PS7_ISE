# Rust build output. dist\ is the published app and is committed on purpose.
/target

# The self-contained payload the installer packages. Built by
# build.ps1 -SelfContained -OutDir dist-setup, then makensis /DPAYLOAD=dist-setup.
# Kept out of the repository: it is the committed dist plus a .NET runtime.
/dist-setup
/dist-sc

# Scratch engine-only publish, for running engine-protocol-test.ps1 without touching the
# committed dist\: build.ps1 -SkipFrontEnd -SkipVersionBump -OutDir .engine-test
/.engine-test

# .NET intermediates; the publish output that matters lives in dist\.
**/bin/
**/obj/
/PowerShellEngineHost/publish/

# Editor and Windows noise
.vs/
*.user
Thumbs.db
Desktop.ini
# macOS noise
.DS_Store
**/.DS_Store

# Cross-platform prototype build output
/cross-platform-ui/target/
